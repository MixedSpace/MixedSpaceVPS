{
  "name": "com.ningfeng.mixedspace",
  "version": "2.0.0",
  "displayName": "MixedSpaceVPS",
  "description": "MixedSpace SDK 是面向 Unity 空间增强现实应用的视觉定位（VPS）开发工具包，提供云端与设备端定位、地图加载与管理、相机图像和跟踪位姿接入、定位调度、位姿融合及诊断日志。通过平台适配器统一对接移动端与 XR 设备，并使用 RunPlan 配置定位模式和运行策略。包内提供 Mobile、PICO 4 Ultra、PICO 4 Ultra Enterprise、PICO 4 Enterprise、Huawei AR Engine、XRany 和 Rokid 的适配示例。",
  "unity": "2022.3",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MixedSpace/MixedSpaceVPS.git"
  },
  "documentationUrl": "https://github.com/MixedSpace/MixedSpaceVPS#readme",
  "dependencies": {
    "com.unity.feature.development": "1.0.1",
    "com.unity.xr.arcore": "5.1.0",
    "com.unity.xr.arfoundation": "5.1.0",
    "com.unity.xr.arkit": "5.1.0",
    "com.unity.xr.openxr": "1.8.2",
    "com.unity.textmeshpro": "3.0.6",
    "com.unity.modules.ui": "1.0.0",
    "com.unity.2d.sprite": "1.0.0",
    "com.unity.render-pipelines.universal": "14.0.9",
    "com.unity.ai.navigation": "1.1.5"
  },
  "keywords": [
    "mixedspace"
  ],
  "author": {
    "name": "mixedspace"
  },
  "samples": [
    {
      "displayName": "RokidAdapter",
      "description": "Rokid 设备平台适配器与示例，用于将相机图像和跟踪位姿接入 MixedSpace SDK。",
      "path": "RokidAdapter~"
    }
  ]
}
